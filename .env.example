# Supabase: Werte aus dem Supabase Dashboard (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Publishable Key (sb_publishable_...). Darf im Browser stehen, RLS schützt die Daten.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# App URL: lokal http://localhost:3000, in Produktion https://deine-domain.de
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret Key (sb_secret_...): umgeht RLS. Nur serverseitig, nie NEXT_PUBLIC_!
# SUPABASE_SECRET_KEY=sb_secret_xxxxx
