# Supabase — Werte aus dem Supabase Dashboard (Project Settings → API Keys)
# Publishable Key (sb_publishable_...) ersetzt den alten anon-Key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# App URL — lokal: http://localhost:3000 | Produktion: https://deine-domain.de
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Secret Key (sb_secret_..., ersetzt service_role) — umgeht RLS!
# NUR serverseitig, NIE NEXT_PUBLIC_. Nur anlegen, wenn wirklich nötig.
# SUPABASE_SECRET_KEY=sb_secret_xxxxx
